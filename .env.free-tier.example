# Free-tier distributed deployment variables for TrimLink
# Copy these to your cloud provider secret manager (do not commit real values)

# ZooKeeper is optional now. Set false to run without ZooKeeper.
TRIMLINK_ZOOKEEPER_ENABLED=false
# Only needed when ZooKeeper is enabled
ZOOKEEPER_SERVER=your-zookeeper-host:your-zookeeper-port

# Key range provider: "redis" (recommended for Valkey) or "zookeeper"
TRIMLINK_KGS_PROVIDER=redis
TRIMLINK_KGS_BLOCK_SIZE=1000

# Redis (Upstash or similar)
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# Sharded Postgres URLs (Neon/Supabase/etc.)
# Use full JDBC URLs, including sslmode=require when needed
TRIMLINK_DB_SHARD_0_URL=jdbc:postgresql://your-shard-0-host/trimlink_db?sslmode=require
TRIMLINK_DB_SHARD_1_URL=jdbc:postgresql://your-shard-1-host/trimlink_db?sslmode=require
TRIMLINK_DB_SHARD_2_URL=jdbc:postgresql://your-shard-2-host/trimlink_db?sslmode=require

TRIMLINK_DB_USERNAME=your-db-user
TRIMLINK_DB_PASSWORD=your-db-password

# Optional tuning
TRIMLINK_DB_INIT_RETRIES=25
TRIMLINK_DB_INIT_RETRY_DELAY_MS=3000

# Gateway runtime routing to registered app nodes
TRIMLINK_NODE_SCHEME=http
TRIMLINK_NODE_PORT=8080

# When ZooKeeper is disabled, gateway routes using this static list.
# For one node: trimlink-node-1.internal
TRIMLINK_GATEWAY_STATIC_NODES=trimlink-node-1.internal

# Node registration name in ZooKeeper (must be resolvable by gateway)
TRIMLINK_NODE_ADVERTISED_HOST=trimlink-node-1.internal
